# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env.local
.env.*.local

# Sessions & Scratch (exclude active content but keep directories)
sessions/*
!sessions/.gitkeep
scratch/*
!scratch/.gitkeep

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary and backup files
*.tmp
*.bak
*.old
*~
*.swp

# VS Code & IDE files
.vscode/*
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
